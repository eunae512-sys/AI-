# OpenAI API key with access to gpt-image-1
# https://platform.openai.com/api-keys
# 결제 활성화 + 이미지 생성 권한 필요 (Tier 1 이상)
OPENAI_API_KEY=sk-...

# Pexels API key — 무료 (200/hr, 20,000/month)
# https://www.pexels.com/api/  → Get Started → API Key
PEXELS_API_KEY=YOUR_PEXELS_KEY

# Optional — 기본값 사용 시 비워두기
# IMAGE_MODEL=gpt-image-1
# IMAGE_QUALITY=medium
# IMAGE_SIZE=1024x1536
# TEXT_MODEL=gpt-4o
# PORT=3000
